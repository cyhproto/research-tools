@article{severson2019data,
  title = {Data-driven prediction of battery cycle life before capacity degradation},
  author = {Severson, Kristen A. and Attia, Peter M. and Jin, Norman and Perkins, Nicholas and Jiang, Benben and Yang, Zi and Chen, Michael H. and Aykol, Muratahan and Herring, Patrick K. and Fraggedakis, Dimitrios and Bazant, Martin Z. and Harris, Stephen J. and Chueh, William C. and Braatz, Richard D.},
  journal = {Nature Energy},
  volume = {4},
  number = {5},
  pages = {383--391},
  year = {2019},
  doi = {10.1038/s41560-019-0356-8},
  abstract = {A dataset of 124 commercial LFP/graphite cells, fast-charged until failure, with cycle lives between 150 and 2,300 cycles. Machine-learning models use features of the discharge voltage curves from early cycles, before capacity starts to fade. With the first 100 cycles, cycle life is predicted with 9.1\% test error; with the first 5 cycles, cells are sorted into two lifetime groups with 4.9\% test error.},
  note = {Abstract paraphrased for this test fixture.}
}

@article{richardson2017gaussian,
  title = {Gaussian process regression for forecasting battery state of health},
  author = {Richardson, Robert R. and Osborne, Michael A. and Howey, David A.},
  journal = {Journal of Power Sources},
  volume = {357},
  pages = {209--219},
  year = {2017},
  doi = {10.1016/j.jpowsour.2017.05.004},
  abstract = {Proposes Gaussian process (GP) regression to forecast the capacity, and so the state of health and remaining useful life, of lithium-ion cells. As a Bayesian non-parametric method, a GP gives its forecasts with uncertainty. Known degradation trends can enter through an explicit mean function, and multi-output GPs share information between cells. The method is shown on capacity-versus-cycle data, for short-term forecasts and for remaining-useful-life prediction.},
  note = {Abstract paraphrased for this test fixture.}
}
